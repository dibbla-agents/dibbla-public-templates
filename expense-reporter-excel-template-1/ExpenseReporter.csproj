<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExpenseReporter</AssemblyName>
    <RootNamespace>ExpenseReporter</RootNamespace>
    <!-- dist/ is generated by the frontend build and served at runtime; never
         compile or embed it as part of the .NET build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;frontend/**</DefaultItemExcludes>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

</Project>
