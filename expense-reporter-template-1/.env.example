# Names of the variables this app needs — one comment each, never a value.
# Values live in Dibbla: `dibbla secrets set NAME value -d <app>` puts one in,
# `dibbla env pull` writes them all to .env.local on this machine (never committed).

PORT=                    # HTTP listen port (default 80; the dev task sets it to 8210)
DIBBLA_AI_GATEWAY_URL=   # Dibbla AI Gateway base URL — injected by the platform on deploy
DIBBLA_ALIAS=            # app alias sent as X-Dibbla-App — injected by the platform on deploy
GATEWAY_URL=             # Dibbla platform gateway for the Google OAuth handshake (default https://api.dibbla.net)
MODE=                    # `dev` makes the backend use DIBBLA_TOKEN instead of the gateway's auth cookie
DIBBLA_TOKEN=            # your Dibbla API token, only read when MODE=dev
