# Names of the variables this app needs — one comment each, never a value.
# Values live in Dibbla: `dibbla secrets set NAME value -d <app>` puts one in,
# `dibbla env pull` writes them all to .env.local on this machine (never committed).

APP_TITLE=                    # display name shown in the UI header (default "Lumen")
DATABASE_URL_LUMEN_INCIDENTS= # Postgres connection string; Dibbla fills it in when you attach the database `lumen_incidents`.
                              # Without it the app runs in first-run mode. For an isolated local run, point it at your own
                              # Postgres, e.g. postgres://user:pass@localhost:5432/lumen_incidents?sslmode=disable
PORT=                         # HTTP listen port (default 80; the dev task sets it)
