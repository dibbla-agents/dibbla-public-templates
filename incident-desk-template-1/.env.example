# Display name shown in the UI header (optional; defaults to "Lumen").
APP_TITLE=Lumen

# Postgres connection string. Optional — with no database bound the app runs in
# first-run mode. The Dibbla platform mints DATABASE_URL_<DBNAME> automatically
# when you attach a database (for `lumen_incidents` that is the variable below).
# For local dev, point it at your own Postgres:
# DATABASE_URL_LUMEN_INCIDENTS=postgres://user:pass@localhost:5432/lumen_incidents?sslmode=disable
